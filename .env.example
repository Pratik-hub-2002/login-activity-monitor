# Copy these placeholders into your local environment configuration.
# Spring Boot does not load .env files automatically.

HCAPTCHA_SITE_KEY=replace-with-hcaptcha-site-key
HCAPTCHA_SECRET=replace-with-hcaptcha-secret
# true forces CAPTCHA on every login; false retains the five-failures-in-ten-minutes threshold.
HCAPTCHA_REQUIRED=false

APP_NOTIFICATION_ADMIN_EMAIL=admin@example.invalid
# Comma-separated username=email mappings. At startup, configured addresses
# are synchronized to matching provisioned users and used for OTP delivery.
APP_NOTIFICATION_USER_EMAILS=monitor-admin=admin@example.invalid

SPRING_MAIL_HOST=smtp.example.invalid
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=replace-with-smtp-username
SPRING_MAIL_PASSWORD=replace-with-smtp-password
APP_NOTIFICATION_FROM=no-reply@example.invalid

# OTP lifetime in seconds. Defaults to 90 when unset.
APP_AUTH_OTP_VALIDITY_SECONDS=90

# Configure the database separately. Never place production credentials here.
# DB_URL=jdbc:mysql://localhost:3306/login_activity_monitor
# DB_USERNAME=replace-with-database-username
# DB_PASSWORD=replace-with-database-password
